{
  "name": "rename within a volume",
  "proves": ["Stage 1 item 1: a link survives a rename when the within-volume key matches"],
  "steps": [
    { "thing": { "as": "dishwasher", "label": "Dishwasher" } },
    { "file": { "as": "warranty", "label": "Warranty.pdf", "volume": "vol-robin", "document": "doc-1", "path": "/Volumes/Robin/Kitchen/Warranty.pdf", "hash": "warranty-v1" } },
    { "link": { "as": "documents", "source": "warranty.artifact", "predicate": "DOCUMENTS", "target": "dishwasher" } },
    { "expect_state": { "relationship": "documents", "state": "PRESENT" } },
    { "observe": { "volume": "vol-robin", "document": "doc-1", "path": "/Volumes/Robin/Kitchen/Dishwasher warranty.pdf", "hash": "warranty-v1", "expect": "RESOLVED", "rule": "within-volume-key", "instance": "warranty", "content_changed": false } },
    { "expect_instance": { "instance": "warranty", "status": "present", "path": "/Volumes/Robin/Kitchen/Dishwasher warranty.pdf" } },
    { "expect_state": { "relationship": "documents", "state": "PRESENT" } },
    { "expect_count": { "entity": "dishwasher", "relationships": 1 } }
  ]
}
